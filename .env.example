# Copy to .env and fill in your own values.
# Get a DID + free sandbox test credits at https://go.terminal3.io/adk-community

# Your operator/tenant private key from the claim page (0x-prefixed 32-byte
# secp256k1 hex — this signs the SIWE-style auth challenge, it is NOT the
# agent's t3n_key_... API key that setup.ts mints later).
T3N_API_KEY=0xyour_private_key_here

# Optional. "testnet" (default) or "sandbox".
T3N_ENVIRONMENT=testnet
